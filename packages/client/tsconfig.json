{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "target": "es2020",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "lib": [
      "DOM",
      "es2020"
    ],
    "baseUrl": ".",
    "paths": {
      "#components/*": [
        "src/components/*"
      ],
      "@gmail-job-manager/shared": [
        "../shared/src/index.ts"
      ]
    },
    "jsx": "react-jsx",
    "types": [
      "vite/client"
    ],
    "noEmit": true
  },
  "include": [
    "src"
  ]
}