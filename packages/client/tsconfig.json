{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "target": "es2020",
    "module": "preserve",
    "moduleResolution": "bundler",
    "lib": [
      "DOM",
      "es2020"
    ],
    "paths": {
      "#components/*": [
        "./src/components/*"
      ],
      "#constants/*": [
        "./src/constants/*"
      ],
      "#pages/*": [
        "./src/pages/*"
      ],
      "@gmail-job-manager/shared": [
        "../shared/src"
      ]
    },
    "jsx": "react-jsx",
    "types": [
      "vite/client"
    ],
    "noEmit": true
  },
  "include": [
    "src"
  ]
}