# Node modules (only at root, since workspaces hoist dependencies)
node_modules/

# Lockfiles only at root, ignore sub-project lockfiles
client/package-lock.json
server/package-lock.json

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Build output
client/dist/
server/dist/
build/

# Environment variables
.env
.env.local
.env.*.local

# IDE/editor configs
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln

# macOS system files
.DS_Store

# Optional: coverage reports
coverage/
